---
/**
 * Works の 1 マス（A-1 グリッド）。
 * 画像はデザイン作品なら microCMS の写真、それ以外はリンク先の OGP 画像。
 * マス全体をリンクにしつつ、GitHub へのリンクは別に押せるようにする。
 */
import Cell from "../../shared/grid/Cell.astro";
import { fetchThumbnailFromOGP } from "../../../lib/ogp";

interface Props {
  index: number;
  label: string;
  title: string;
  subtitle?: string;
  url: string;
  githubUrl?: string;
  genre?: "programming" | "design";
  photos?: { url: string; height: number; width: number }[];
  col: string;
}

const { index, label, title, subtitle, url, githubUrl, genre, photos, col } =
  Astro.props;

const isExternal = /^https?:\/\//.test(url);

let imageUrl: string | undefined;
if (genre === "design" && photos && photos.length > 0) {
  imageUrl = `${photos[0].url}?w=960&fm=webp&q=75`;
} else if (isExternal) {
  imageUrl = (await fetchThumbnailFromOGP(url)) ?? undefined;
}
---

<Cell
  col={col}
  spread
  class:list={["work", "is-link", { "is-external": isExternal }]}
>
  <div class="grid-tag">
    <span class="grid-label grid-label--accent">
      {label} — W{String(index).padStart(2, "0")}
    </span>
    {
      githubUrl && (
        <a
          class="grid-label text-link work__github"
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      )
    }
  </div>

  <div class="work__thumb">
    {
      imageUrl ? (
        <img src={imageUrl} alt="" loading="lazy" />
      ) : (
        <span class="grid-label grid-label--faint">No image</span>
      )
    }
  </div>

  <div>
    <a
      class="grid-serif-m work__link"
      href={url}
      {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
    >
      {title}
    </a>
    {subtitle && <p class="work__subtitle">{subtitle}</p>}
  </div>
</Cell>

<style>
  .work {
    transition: background-color var(--transition);
  }

  .work:hover {
    background: var(--color-bg-subtle);
  }

  /* タイトルのリンクをマス全体に広げる */
  .work__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .work__github {
    position: relative;
    z-index: 1;
    transition: color var(--transition);
  }

  .work__github:hover {
    color: var(--color-accent-strong);
  }

  .work__thumb {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    padding: var(--spacing-md);
    overflow: hidden;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-rule);
  }

  .work__thumb:has(img) {
    padding: 0;
  }

  .work__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work__subtitle {
    margin-top: var(--spacing-sm);
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }
</style>
