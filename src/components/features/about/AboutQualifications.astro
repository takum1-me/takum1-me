---
import SectionHeading from "../../shared/page/SectionHeading.astro";
import type { AboutItem } from "../../../lib/microcms";
import { formatDate } from "./date-utils";

interface Props {
  certifications: AboutItem[];
}

const { certifications } = Astro.props;
---

<section>
  <SectionHeading eyebrow="Certification" title="資格" />

  <dl class="cert-list">
    {
      certifications.map((certification) => (
        <div class="cert-item">
          <dt>{certification.title}</dt>
          {certification.beginDate && (
            <dd>{formatDate(certification.beginDate)}</dd>
          )}
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* 上の罫線は SectionHeading が持っているので、ここでは引かない */
  .cert-list {
    margin: 0;
  }

  /* 資格名と取得日を両端に置いた、目次のような並び */
  .cert-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cert-item dt {
    font-size: var(--text-body);
    font-weight: 600;
  }

  .cert-item dd {
    margin: 0;
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
