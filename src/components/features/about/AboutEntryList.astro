---
import SectionHeading from "../../shared/page/SectionHeading.astro";
import type { AboutItem } from "../../../lib/microcms";
import { formatPeriod, formatRolePeriod } from "./date-utils";

interface Props {
  eyebrow: string;
  title: string;
  items: AboutItem[];
}

const { eyebrow, title, items } = Astro.props;
---

{
  items.length > 0 && (
    <section>
      <SectionHeading eyebrow={eyebrow} title={title} />

      <ul class="entry-list">
        {items.map((item) => (
          <li class="entry-item">
            <h3 class="entry-item__name">
              {item.link ? (
                <a href={item.link} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>

            {item.beginDate && (
              <p class="entry-item__period">
                {formatPeriod(item.beginDate, item.finishDate)}
              </p>
            )}

            {item.specific && (
              <p class="entry-item__role">
                {item.specific}
                {item.specificBeiginDate &&
                  `（${formatRolePeriod(item.specificBeiginDate, item.specificFinishDate)}）`}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .entry-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--spacing-lg) var(--spacing-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry-item {
    display: grid;
    gap: 0.3rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-line-strong);
  }

  .entry-item__name {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.5;
  }

  .entry-item__name a {
    transition: color var(--transition);
  }

  .entry-item__name a:hover {
    color: var(--color-accent-strong);
  }

  .entry-item__period {
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  .entry-item__role {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }
</style>
