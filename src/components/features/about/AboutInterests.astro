---
import SectionHeading from "../../shared/page/SectionHeading.astro";
import CoffeeFlavorTag from "../coffee/CoffeeFlavorTag";
import type { AboutItem } from "../../../lib/microcms";
import "../coffee/coffee-flavor-tag.css";

interface Props {
  favoriteItems: AboutItem[];
  favoriteCoffees: AboutItem[];
  favoriteFlavors: AboutItem[];
  interests: AboutItem[];
}

const { favoriteItems, favoriteCoffees, favoriteFlavors, interests } =
  Astro.props;
---

<section>
  <SectionHeading eyebrow="Interests" title="趣味・関心" />

  <p class="about-lead">
    コーヒーが好きです。大学ではプログラミングをしています。
  </p>

  <div class="about-rows">
    <div class="about-row">
      <h3 class="about-row__label">使用器具</h3>
      <div class="tag-list">
        {favoriteItems.map((item) => <span class="tag">{item.title}</span>)}
      </div>
    </div>

    <div class="about-row">
      <h3 class="about-row__label">お気に入りの産地・品種</h3>
      <div class="tag-list">
        {
          favoriteCoffees.map((item) => (
            <span class="tag is-accent">{item.title}</span>
          ))
        }
      </div>
    </div>

    <div class="about-row">
      <h3 class="about-row__label">好きなフレーバー</h3>
      <div class="tag-list">
        {
          favoriteFlavors.map((item) => (
            <CoffeeFlavorTag flavorName={item.title} />
          ))
        }
      </div>
    </div>

    <div class="about-row">
      <h3 class="about-row__label">その他の関心</h3>
      <div class="tag-list">
        {interests.map((item) => <span class="tag">{item.title}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .about-lead {
    max-width: 34rem;
    margin-bottom: var(--spacing-xl);
    color: var(--color-ink-muted);
  }

  .about-rows {
    display: grid;
    gap: var(--spacing-lg);
  }

  /* ラベルと中身を 2 カラムに揃えて、目線が縦に流れるようにする */
  .about-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.75rem var(--spacing-lg);
    align-items: baseline;
  }

  .about-row__label {
    color: var(--color-ink-faint);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .tag.is-accent {
    border-color: var(--color-line-strong);
    color: var(--color-accent-strong);
  }

  @media (width <= 40rem) {
    .about-row {
      grid-template-columns: 1fr;
    }
  }
</style>
