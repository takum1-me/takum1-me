---
import SectionHeading from "../../shared/page/SectionHeading.astro";
import type { AboutItem } from "../../../lib/microcms";
import { formatPeriod, formatRolePeriod } from "./date-utils";

interface Props {
  organizations: AboutItem[];
}

const { organizations } = Astro.props;
---

<section>
  <SectionHeading eyebrow="Affiliation" title="所属" />

  <ul class="org-list">
    {
      organizations.map((organization) => (
        <li class="org-item">
          <h3 class="org-item__name">
            {organization.link ? (
              <a
                href={organization.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {organization.title}
              </a>
            ) : (
              organization.title
            )}
          </h3>

          {organization.beginDate && (
            <p class="org-item__period">
              {formatPeriod(organization.beginDate, organization.finishDate)}
            </p>
          )}

          {organization.specific && (
            <p class="org-item__role">
              {organization.specific}
              {organization.specificBeiginDate &&
                `（${formatRolePeriod(organization.specificBeiginDate, organization.specificFinishDate)}）`}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .org-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--spacing-lg) var(--spacing-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .org-item {
    display: grid;
    gap: 0.3rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-line-strong);
  }

  .org-item__name {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.5;
  }

  .org-item__name a {
    transition: color var(--transition);
  }

  .org-item__name a:hover {
    color: var(--color-accent-strong);
  }

  .org-item__period {
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  .org-item__role {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }
</style>
