---
/**
 * 全ページ共通のページ見出し（A-1 グリッド）。
 * 左の大きなマスに英単語（word）を巨大に組み、右のマスに導入文を置く。
 * aside スロットは導入文の下のマスに出す（関連ページへのリンクなど）。
 * title（和文）は画面には出さない。巨大な英単語と導入文で足り、和文の添え書きは
 * テンションが浮くため（2026-11-19）。見出しの読み上げにだけ使う。
 *
 * ルート自体が Grid なので、<Container size="frame"> の中で本文の Grid と
 * 並べると、境目の罫線は 1 本にまとまる。
 */
import Grid from "../grid/Grid.astro";
import Cell from "../grid/Cell.astro";

export interface Props {
  /** 日本語の見出し。word があるときは画面に出さず、h1 の読み上げに添える */
  title: string;
  /** マスいっぱいに組む英単語（"Works" など）。無いときは title を見出しにする */
  word?: string;
  lead?: string;
  /** 見出しのマスを詰める（現場で 1 画面に収めたいページ向け） */
  compact?: boolean;
}

const { title, word, lead, compact = false } = Astro.props;
// 下に伸びる字（g / j / p / q / y）があるときだけ、字面を罫線に寄せずに余白を残す
const hasDescender = word ? /[gjpqy]/.test(word) : false;
const hasAside = Astro.slots.has("aside");
const hasSide = Boolean(lead) || hasAside;
---

<Grid as="header" class="page-header">
  <Cell
    col={hasSide ? "1 / 9" : "1 / 13"}
    row={hasAside ? "span 2" : "auto"}
    fit={Boolean(word)}
    class:list={["page-header__main", { "is-compact": compact }]}
  >
    {
      word ? (
        <h1
          class:list={[
            "grid-giant",
            "page-header__word",
            { "has-descender": hasDescender },
          ]}
        >
          {word}
          <span class="sr-only">（{title}）</span>
        </h1>
      ) : (
        <h1 class="grid-title-l">{title}</h1>
      )
    }
  </Cell>

  {
    lead && (
      <Cell col="9 / 13">
        <p class="grid-statement">{lead}</p>
      </Cell>
    )
  }

  {
    hasAside && (
      <Cell col="9 / 13" class="page-header__aside">
        <slot name="aside" />
      </Cell>
    )
  }
</Grid>

<style>
  /* 巨大な英単語はマスの下端（罫線）に乗せる */
  .page-header__main {
    justify-content: flex-end;
    min-height: clamp(12rem, 22vw, 20rem);
  }

  .page-header__main.is-compact {
    min-height: 0;
  }

  /* 巨大な英単語は字面の下端をマスの罫線に寄せる */
  .page-header__word {
    margin-left: -0.04em;
    margin-bottom: -0.04em;
  }

  /* g や y の下に伸びる部分はマスで切らずに見せる */
  .page-header__word.has-descender {
    margin-bottom: 0;
    padding-bottom: 0.2em;
  }

  .page-header__aside {
    justify-content: flex-end;
    gap: var(--spacing-sm);
  }

  @media (width <= 48rem) {
    .page-header__main {
      min-height: 10rem;
    }
  }
</style>
