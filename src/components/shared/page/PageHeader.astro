---
/**
 * 全ページ共通のページ見出し（A-1 グリッド）。
 * 左の大きなマスに英単語（word）を巨大に組み、右のマスに導入文を置く。
 * aside スロットは導入文の下に墨のマスとして出す（関連ページへのリンクなど）。
 *
 * ルート自体が Grid なので、<Container size="frame"> の中で本文の Grid と
 * 並べると、境目の罫線は 1 本にまとまる。
 */
import Grid from "../grid/Grid.astro";
import Cell from "../grid/Cell.astro";

export interface Props {
  /** 日本語の見出し。word があるときはその上のラベルになる */
  title: string;
  /** マスいっぱいに組む英単語（"Works" など）。無いときは title を見出しにする */
  word?: string;
  lead?: string;
}

const { title, word, lead } = Astro.props;
const hasAside = Astro.slots.has("aside");
const hasSide = Boolean(lead) || hasAside;
---

<Grid as="header" class="page-header">
  <Cell
    col={hasSide ? "1 / 9" : "1 / 13"}
    row={hasAside ? "span 2" : "auto"}
    spread
    fit={Boolean(word)}
    class="page-header__main"
  >
    {
      word ? (
        <>
          <p class="grid-label grid-label--accent">{title}</p>
          <h1 class="grid-giant page-header__word">{word}</h1>
        </>
      ) : (
        <>
          <span class="grid-label grid-label--accent">Page</span>
          <h1 class="grid-serif-l">{title}</h1>
        </>
      )
    }
  </Cell>

  {
    lead && (
      <Cell col="9 / 13" spread>
        <span class="grid-label grid-label--accent">Intro</span>
        <p class="grid-statement">{lead}</p>
      </Cell>
    )
  }

  {
    hasAside && (
      <Cell col="9 / 13" tone="ink" class="page-header__aside">
        <slot name="aside" />
      </Cell>
    )
  }
</Grid>

<style>
  .page-header__main {
    min-height: clamp(12rem, 22vw, 20rem);
  }

  /* 巨大な英単語は字面の下端をマスの罫線に寄せる */
  .page-header__word {
    margin-left: -0.04em;
    margin-bottom: -0.04em;
  }

  .page-header__aside {
    justify-content: center;
    gap: var(--spacing-sm);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  @media (width <= 48rem) {
    .page-header__main {
      min-height: 10rem;
    }
  }
</style>
