---
/**
 * 罫線グリッド（2026-11 リデザイン「A-1」）。
 * 1px の隙間から背景の墨色をのぞかせて罫線にする。PC は 12 カラム、
 * スマホは 2 カラム。マスの置き方は子の Cell.astro が決める。
 *
 * 幅は持たない。外側を <Container size="frame"> で包むこと。
 */
export interface Props {
  as?: "div" | "section" | "article" | "header" | "footer" | "nav";
  class?: string;
}

const { as: Tag = "div", class: className, ...rest } = Astro.props;
---

<!-- 動的タグなので rest（呼び出し元の data-astro-cid-*）を必ず渡す -->
<Tag class:list={["grid", className]} {...rest}>
  <slot />
</Tag>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(var(--spacing-row), auto);
    grid-auto-flow: row dense;
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
  }

  /* グリッドを縦に重ねたとき、境目の罫線が 2 本にならないようにする */
  .grid + .grid {
    border-top: 0;
  }

  @media (width <= 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }
  }
</style>
