---
import { getAllLabArticles, getLabArticleById } from "../../lib/microcms/lab";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/layout/Container.astro";
import "../../styles/prose.css";

export async function getStaticPaths() {
  try {
    const articles = await getAllLabArticles();
    return articles.map((article) => ({ params: { slug: article.id } }));
  } catch (error) {
    console.error("[lab] static paths fetch failed:", error);
    return [];
  }
}

const { slug } = Astro.params;
const article = slug ? await getLabArticleById(slug) : null;

if (!article) {
  return Astro.redirect("/404");
}

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Tokyo",
  });
---

<Layout title={article.title}>
  <Container size="prose" as="article" class="article">
    <a class="article__back" href="/lab">
      <span aria-hidden="true">←</span> Lab 一覧に戻る
    </a>

    <header class="article__header">
      <p class="article__meta">
        <time datetime={article.publishedAt}>
          {formatDate(article.publishedAt)}
        </time>
        {
          article.category?.map((category) => (
            <span class="article__tag">#{category}</span>
          ))
        }
      </p>
      <h1 class="article__title">{article.title}</h1>
    </header>

    {
      article.eyecatch && (
        <img
          class="article__eyecatch"
          src={article.eyecatch.url}
          alt=""
          loading="lazy"
        />
      )
    }

    <div class="prose" set:html={article.content} />
  </Container>
</Layout>

<style>
  .article {
    padding-block: var(--spacing-xl) var(--spacing-3xl);
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    font-weight: 600;
    transition: color var(--transition);
  }

  .article__back:hover {
    color: var(--color-accent-strong);
  }

  .article__header {
    margin-block: var(--spacing-xl) var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    color: var(--color-ink-faint);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
  }

  .article__title {
    font-size: var(--text-h1);
    font-weight: 700;
    line-height: var(--text-h1--line-height);
    letter-spacing: var(--text-h1--letter-spacing);
  }

  .article__eyecatch {
    width: 100%;
    height: auto;
    margin-bottom: var(--spacing-xl);
    border-radius: var(--radius-md);
  }
</style>
