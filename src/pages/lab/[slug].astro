---
/**
 * Lab の記事（A-1 グリッド）。
 * 左の細い列に目次（本文の h2 から作る）を貼り付け、右の広い列に本文を組む。
 */
import { getAllLabArticles, getLabArticleById } from "../../lib/microcms/lab";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/layout/Container.astro";
import Grid from "../../components/shared/grid/Grid.astro";
import Cell from "../../components/shared/grid/Cell.astro";
import { formatDotDate } from "../../lib/utils/dot-date";
import "../../styles/prose.css";

export async function getStaticPaths() {
  try {
    const articles = await getAllLabArticles();
    return articles.map((article) => ({ params: { slug: article.id } }));
  } catch (error) {
    console.error("[lab] static paths fetch failed:", error);
    return [];
  }
}

const { slug } = Astro.params;
const article = slug ? await getLabArticleById(slug) : null;

if (!article) {
  return Astro.redirect("/404");
}

// 本文の h2 に id を振り、その一覧を目次にする
const toc: { id: string; text: string }[] = [];
const content = article.content.replace(
  /<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/g,
  (match, attrs = "", inner: string) => {
    const text = inner.replace(/<[^>]+>/g, "").trim();
    if (!text) return match;
    const existing = /\sid="([^"]+)"/.exec(attrs);
    const id = existing ? existing[1] : `section-${toc.length + 1}`;
    toc.push({ id, text });
    return existing ? match : `<h2${attrs} id="${id}">${inner}</h2>`;
  },
);
---

<Layout title={article.title}>
  <Container size="frame" as="article">
    <Grid class="article-grid">
      <Cell col="1 / 4" href="/lab" class="article-back is-back">
        <span class="grid-label">Lab 一覧</span>
      </Cell>
      <Cell col="4 / 13">
        <div class="grid-tag">
          <span class="grid-label grid-label--accent">
            {(article.category ?? []).map((tag) => `#${tag}`).join(" ")}
          </span>
          <time class="grid-number" datetime={article.publishedAt}>
            {formatDotDate(article.publishedAt)}
          </time>
        </div>
      </Cell>

      <Cell col={article.eyecatch ? "1 / 9" : "1 / 13"} class="article-title">
        <h1 class="grid-serif-l">{article.title}</h1>
      </Cell>
      {
        article.eyecatch && (
          <Cell col="9 / 13" bleed class="article-eyecatch">
            <img src={article.eyecatch.url} alt="" loading="lazy" />
          </Cell>
        )
      }

      {
        toc.length > 0 && (
          <Cell col="1 / 4" class="article-toc">
            <nav class="article-toc__inner" aria-label="目次">
              <p class="grid-label grid-label--accent">Contents</p>
              <ol class="article-toc__list">
                {toc.map((item, i) => (
                  <li>
                    <a class="link-row" href={`#${item.id}`}>
                      <span class="grid-number article-toc__no">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span>{item.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </Cell>
        )
      }

      <Cell col={toc.length > 0 ? "4 / 13" : "1 / 13"} class="article-body">
        <div class="prose" set:html={content} />
      </Cell>

      <Cell col="1 / 13" href="/lab" class="article-back is-back">
        <span class="grid-label">Lab 一覧に戻る</span>
      </Cell>
    </Grid>
  </Container>
</Layout>

<style>
  .article-grid {
    grid-auto-rows: auto;
  }

  .article-back {
    justify-content: center;
  }

  .article-title {
    padding-block: clamp(2rem, 5vw, 4rem) var(--spacing-cell);
  }

  .article-eyecatch img {
    flex: 1;
    width: 100%;
    object-fit: cover;
  }

  /* 目次を画面に貼り付けるため、マスのはみ出し隠しをこの列だけ外す */
  .article-toc.article-toc {
    overflow: visible;
  }

  .article-toc__inner {
    position: sticky;
    top: calc(var(--header-height) + var(--spacing-cell));
  }

  .article-toc__list {
    margin: var(--spacing-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .article-toc__list a {
    display: flex;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
    border-top: 1px solid var(--color-line-strong);
    font-size: var(--text-small);
    line-height: 1.5;
    transition: color var(--transition);
  }

  .article-toc__list a:hover {
    color: var(--color-accent-strong);
  }

  .article-toc__no {
    flex: none;
    color: var(--color-accent);
    font-size: var(--text-small);
  }

  .article-body {
    padding-block: var(--spacing-xl) var(--spacing-3xl);
  }

  .article-body .prose {
    max-width: var(--container-prose);
  }

  @media (width <= 48rem) {
    .article-toc__inner {
      position: static;
    }
  }
</style>
