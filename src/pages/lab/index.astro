---
import { getAllLabArticles, type LabArticle } from "../../lib/microcms/lab";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/layout/Container.astro";
import PageHeader from "../../components/shared/page/PageHeader.astro";

let articles: LabArticle[] = [];
let loadError = false;

try {
  articles = await getAllLabArticles();
} catch (error) {
  console.error("[lab] fetch failed:", error);
  loadError = true;
}

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Tokyo",
  });
---

<Layout title="Lab">
  <Container size="prose">
    <PageHeader
      eyebrow="Lab"
      title="試したこと"
      lead="コーヒーまわりでやったことの記録。抽出用カスタムウォーターのレシピ、3D プリンターで作った道具のモデル配布、焙煎プロファイルの公開など。"
    />

    {
      loadError && (
        <p class="lab-empty">
          記事を取得できませんでした。時間をおいて再度お試しください。
        </p>
      )
    }

    {
      !loadError && articles.length === 0 && (
        <p class="lab-empty">まだ記事がありません。</p>
      )
    }

    <ul class="lab-list">
      {
        articles.map((article) => (
          <li class="lab-list__item">
            <a class="lab-list__link" href={`/lab/${article.id}`}>
              <time class="lab-list__date" datetime={article.publishedAt}>
                {formatDate(article.publishedAt)}
              </time>
              <h2 class="lab-list__title">{article.title}</h2>
              {article.category && article.category.length > 0 && (
                <p class="lab-list__tags">
                  {article.category.map((category) => (
                    <span>#{category}</span>
                  ))}
                </p>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>

<style>
  .lab-empty {
    color: var(--color-ink-faint);
  }

  /* 上の罫線は PageHeader が持っているので、ここでは引かない */
  .lab-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lab-list__item {
    border-bottom: 1px solid var(--color-line);
  }

  /* 記事一覧は面を持たせず、罫線だけで区切る */
  .lab-list__link {
    display: grid;
    gap: 0.4rem;
    padding: 1.35rem 0.75rem 1.45rem;
    margin-inline: -0.75rem;
    transition: background-color var(--transition);
  }

  .lab-list__link:hover {
    background: var(--color-accent-soft);
  }

  .lab-list__date {
    color: var(--color-ink-faint);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    font-variant-numeric: tabular-nums;
  }

  .lab-list__title {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.55;
    transition: color var(--transition);
  }

  .lab-list__link:hover .lab-list__title {
    color: var(--color-accent-strong);
  }

  .lab-list__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--color-ink-faint);
    font-size: var(--text-small);
  }
</style>
