---
/**
 * Lab 一覧（A-1 グリッド）。最新の記事を銅色の大きなマスに置き、
 * 右にタグごとの件数、残りの記事は 2 列のマスに並べる。
 */
import { getAllLabArticles, type LabArticle } from "../../lib/microcms/lab";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/layout/Container.astro";
import PageHeader from "../../components/shared/page/PageHeader.astro";
import Grid from "../../components/shared/grid/Grid.astro";
import Cell from "../../components/shared/grid/Cell.astro";
import { formatDotDate } from "../../lib/utils/dot-date";

let articles: LabArticle[] = [];
let loadError = false;

try {
  articles = await getAllLabArticles();
} catch (error) {
  console.error("[lab] fetch failed:", error);
  loadError = true;
}

const [featured, ...rest] = articles;

// タグごとの件数（多い順）
const tagCounts = [
  ...articles
    .flatMap((article) => article.category ?? [])
    .reduce(
      (map, tag) => map.set(tag, (map.get(tag) ?? 0) + 1),
      new Map<string, number>(),
    ),
].sort((a, b) => b[1] - a[1]);
---

<Layout title="Lab">
  <Container size="frame">
    <PageHeader
      word="Lab"
      title="試したこと"
      lead="コーヒーまわりで試したことの記録です。抽出用の水のレシピや、3D プリンターで作った道具のデータ、焙煎プロファイルを置いています。"
    />

    <Grid>
      {
        !featured && (
          <Cell>
            <p class="lab-empty">
              {loadError
                ? "記事を読み込めませんでした。"
                : "まだ記事がありません。"}
            </p>
          </Cell>
        )
      }

      {
        featured && (
          <Cell
            col={tagCounts.length > 0 ? "1 / 9" : "1 / 13"}
            tone="accent"
            spread
            href={`/lab/${featured.id}`}
            class="lab-featured"
          >
            <div class="grid-tag">
              <span class="grid-label">
                {(featured.category ?? []).map((tag) => `#${tag}`).join(" ")}
              </span>
              <time class="grid-number" datetime={featured.publishedAt}>
                {formatDotDate(featured.publishedAt)}
              </time>
            </div>
            <h2 class="grid-serif-l lab-featured__title">{featured.title}</h2>
          </Cell>
        )
      }

      {
        tagCounts.length > 0 && (
          <Cell col="9 / 13">
            <p class="grid-label grid-label--accent">Tags</p>
            <ul class="lab-tags">
              {tagCounts.map(([tag, count]) => (
                <li class="lab-tags__row">
                  <span class="lab-tags__name">#{tag}</span>
                  <span class="grid-number lab-tags__count">{count}</span>
                </li>
              ))}
            </ul>
          </Cell>
        )
      }

      {
        rest.map((article) => (
          <Cell col="span 6" spread href={`/lab/${article.id}`}>
            <div class="grid-tag">
              <span class="grid-label grid-label--accent">
                {(article.category ?? []).map((tag) => `#${tag}`).join(" ")}
              </span>
              <time class="grid-number" datetime={article.publishedAt}>
                {formatDotDate(article.publishedAt)}
              </time>
            </div>
            <h2 class="grid-entry">{article.title}</h2>
          </Cell>
        ))
      }
    </Grid>
  </Container>
</Layout>

<style>
  .lab-empty {
    color: var(--color-ink-faint);
  }

  .lab-featured {
    min-height: clamp(14rem, 24vw, 22rem);
  }

  .lab-featured:hover {
    background: var(--color-accent-strong);
    color: var(--color-on-ink);
  }

  .lab-featured__title {
    max-width: 18em;
  }

  .lab-tags {
    margin: var(--spacing-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .lab-tags__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--spacing-sm);
    border-top: 1px solid var(--color-rule);
  }

  .lab-tags__name {
    font-size: var(--text-small);
    font-weight: 700;
  }

  .lab-tags__count {
    color: var(--color-accent);
  }
</style>
