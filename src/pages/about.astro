---
/**
 * About（A-1 グリッド）。microCMS の about を genre ごとにマスへ振り分ける。
 */
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/layout/Container.astro";
import PageHeader from "../components/shared/page/PageHeader.astro";
import Grid from "../components/shared/grid/Grid.astro";
import Cell from "../components/shared/grid/Cell.astro";
import { getAllAbout, type AboutItem } from "../lib/microcms";
import { matchFlavorColor } from "../lib/utils/flavor-color";
import FlavorWords from "../components/shared/flavor/FlavorWords.astro";
import { SNS_LINKS } from "../data/site-links";
import SnsIcon from "../components/shared/sns-links/SnsIcon";
import {
  formatDate,
  formatPeriod,
  formatRolePeriod,
} from "../components/features/about/date-utils";

let aboutItems: AboutItem[] = [];
try {
  const response = await getAllAbout();
  aboutItems = response.contents;
} catch (error) {
  // 環境変数が設定されていない場合は空配列を使用
  console.error("Failed to fetch about data:", error);
}

const byGenre = (genre: AboutItem["genre"][number]) =>
  aboutItems.filter((item) => item.genre.includes(genre));

const favoriteItems = byGenre("favorite-item");
const favoriteCoffees = byGenre("favorite-coffee");
const favoriteFlavors = byGenre("favorite-flavor").map((item) =>
  matchFlavorColor(item.title),
);
const interests = byGenre("interest");
const organizations = byGenre("organization");
const certifications = byGenre("certification");
const experiences = byGenre("experience").sort((a, b) =>
  (b.beginDate ?? "").localeCompare(a.beginDate ?? ""),
);

const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="About">
  <Container size="frame">
    <PageHeader
      word="About"
      title="takum1 について"
      lead="筑波大学 情報科学類に在籍しています。コーヒーの抽出と焙煎を続けています。"
    />

    <Grid>
      <!-- 使用器具 -->
      <Cell col="1 / 5">
        <h2 class="grid-heading">Gear</h2>
        <ol class="about-rows">
          {
            favoriteItems.map((item, i) => (
              <li class="about-row about-row--inline">
                <span class="grid-number about-row__no">{pad(i + 1)}</span>
                <span class="grid-entry">{item.title}</span>
              </li>
            ))
          }
        </ol>
      </Cell>

      <!-- 産地・品種 -->
      <Cell col="5 / 9">
        <h2 class="grid-heading">Origin</h2>
        <ul class="about-chips">
          {
            favoriteCoffees.map((item) => (
              <li class="grid-label">{item.title}</li>
            ))
          }
        </ul>
      </Cell>

      <!-- 好きなフレーバー -->
      <Cell col="9 / 13">
        <h2 class="grid-heading">Flavor</h2>
        <FlavorWords notes={favoriteFlavors} class="about-flavors" />
      </Cell>

      <!-- 所属 -->
      {
        organizations.length > 0 && (
          <Cell col="1 / 9">
            <div class="grid-tag">
              <h2 class="grid-heading">Affiliation</h2>
              <p class="grid-label grid-label--faint">
                {pad(organizations.length)}
              </p>
            </div>
            <ul class="about-rows">
              {organizations.map((item) => (
                <li class="about-row">
                  <span class="about-row__period">
                    {formatPeriod(item.beginDate, item.finishDate)}
                  </span>
                  <span class="about-row__body">
                    <span class="grid-entry">
                      {item.link ? (
                        <a
                          class="text-link"
                          href={item.link}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </span>
                    {item.specific && (
                      <span class="about-row__role">
                        {item.specific}
                        {item.specificBeiginDate &&
                          `（${formatRolePeriod(item.specificBeiginDate, item.specificFinishDate)}）`}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </Cell>
        )
      }

      <!-- 資格 -->
      {
        certifications.length > 0 && (
          <Cell col="9 / 13">
            <h2 class="grid-heading">Certification</h2>
            <ul class="about-rows">
              {certifications.map((item) => (
                <li class="about-row about-row--soft">
                  <span class="about-cert">{item.title}</span>
                  {item.beginDate && (
                    <span class="grid-number about-cert__date">
                      {formatDate(item.beginDate)}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </Cell>
        )
      }

      <!-- 経験 -->
      {
        experiences.length > 0 && (
          <Cell col="1 / 9">
            <h2 class="grid-heading">Experience</h2>
            <ul class="about-rows">
              {experiences.map((item) => (
                <li class="about-row">
                  <span class="about-row__period">
                    {formatPeriod(item.beginDate, item.finishDate)}
                  </span>
                  <span class="about-row__body">
                    <span class="grid-entry">{item.title}</span>
                    {item.specific && (
                      <span class="about-row__role">{item.specific}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </Cell>
        )
      }

      <!-- その他の関心 -->
      <Cell col={experiences.length > 0 ? "9 / 13" : "1 / 13"}>
        <h2 class="grid-heading">Interests</h2>
        <p class="grid-statement about-interests">
          {interests.map((item) => item.title).join("、")}
        </p>
      </Cell>

      <!-- 連絡先 -->
      {
        SNS_LINKS.map((sns, i) => (
          <Cell
            col={`${1 + i * 4} / ${5 + i * 4}`}
            sp={i === 2 ? "span 2" : "span 1"}
            spread
            href={sns.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <SnsIcon variant={sns.variant} size={40} className="about-sns" />
            <span class="grid-title-m">{sns.name}</span>
          </Cell>
        ))
      }
    </Grid>
  </Container>
</Layout>

<style>
  .about-rows {
    margin: var(--spacing-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .about-row {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-md) var(--spacing-lg);
    padding-block: var(--spacing-md);
    border-top: 1px solid var(--color-rule);
  }

  /* 資格の行は区切り線を引かず、余白で分ける */
  .about-row--soft {
    border-top: 0;
    padding-block: var(--spacing-sm);
  }

  .about-row__no {
    flex: none;
    color: var(--color-ink-faint);
  }

  .about-row__period {
    flex: none;
    width: 12rem;
    font-size: var(--text-lead);
  }

  .about-row__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .about-row__role {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  .about-cert {
    flex: 1;
    font-size: var(--text-small);
    font-weight: 600;
  }

  .about-cert__date {
    color: var(--color-ink-faint);
  }

  /* 産地・品種は枠で囲まず、語を並べるだけにする */
  .about-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-lg);
    margin: var(--spacing-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .about-flavors,
  .about-interests {
    margin-top: var(--spacing-md);
  }

  @media (width <= 48rem) {
    .about-row {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .about-row__period {
      width: auto;
    }

    .about-row--soft,
    .about-row--inline {
      flex-direction: row;
    }
  }
</style>
