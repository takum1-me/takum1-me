---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/layout/Container.astro";
---

<Layout title="ページが見つかりません">
  <Container size="prose" class="notfound">
    <p class="notfound__code">404</p>
    <h1 class="notfound__title">ページが見つかりません</h1>
    <p class="notfound__body">
      お探しのページは存在しないか、移動された可能性があります。
    </p>
    <a class="notfound__link" href="/">
      トップページに戻る <span aria-hidden="true">→</span>
    </a>
  </Container>
</Layout>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: var(--spacing-md);
    padding-block: clamp(4rem, 15vh, 8rem);
  }

  .notfound__code {
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: clamp(4rem, 14vw, 8rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .notfound__title {
    font-size: var(--text-h2);
    font-weight: 700;
  }

  .notfound__body {
    color: var(--color-ink-muted);
  }

  .notfound__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: var(--spacing-md);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-line-strong);
    font-size: var(--text-small);
    font-weight: 600;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  .notfound__link span {
    transition: transform var(--transition);
  }

  .notfound__link:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .notfound__link:hover span {
    transform: translateX(0.2rem);
  }
</style>
