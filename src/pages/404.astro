---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/layout/Container.astro";
import PageHeader from "../components/shared/page/PageHeader.astro";
import Grid from "../components/shared/grid/Grid.astro";
import Cell from "../components/shared/grid/Cell.astro";
---

<Layout title="ページが見つかりません">
  <Container size="frame">
    <PageHeader
      word="404"
      title="ページが見つかりません"
      lead="URL が変わったか、ページを消したのかもしれません。"
    />
    <Grid>
      <Cell col="1 / 9" tone="subtle" />
      <Cell col="9 / 13" tone="ink" href="/" class="notfound-home">
        <span class="grid-label">Home</span>
        <span class="grid-serif-l">トップへ</span>
      </Cell>
    </Grid>
  </Container>
</Layout>

<style>
  .notfound-home {
    justify-content: space-between;
  }
</style>
