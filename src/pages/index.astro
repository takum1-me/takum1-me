---
/**
 * トップページ（A-1 グリッド）。
 * 段を積まず、12 カラムの罫線グリッドに大小のマスを詰めて 1 画面半に収める。
 */
import Layout from "../layouts/Layout.astro";
import { formatDotDate } from "../lib/utils/dot-date";
import Container from "../components/shared/layout/Container.astro";
import Grid from "../components/shared/grid/Grid.astro";
import Cell from "../components/shared/grid/Cell.astro";
import { getAllWorks, getLatestPhotos } from "../lib/microcms";
import {
  getAllBeans,
  sortBeansForDisplay,
  toArray,
  beanPath,
  type Bean,
} from "../lib/microcms/beans-list";
import { fetchNoteRSS, type NoteArticle } from "../lib/note-rss";
import { loadSongsData } from "../lib/songs-loader";
import { flavorColors } from "../lib/utils/flavor-color";
import { processLabel, roastLabel } from "../data/bean-meta";
import FlavorWords from "../components/shared/flavor/FlavorWords.astro";

// --- データ ---------------------------------------------------------------
// どれか 1 つの取得に失敗しても、残りのマスは出せるようにしておく

async function safely<T>(load: () => Promise<T>, fallback: T): Promise<T> {
  try {
    return await load();
  } catch (error) {
    console.error("トップページのデータ取得に失敗しました:", error);
    return fallback;
  }
}

const [beans, articles, worksResponse, songs, photos] = await Promise.all([
  safely<Bean[]>(getAllBeans, []),
  safely<NoteArticle[]>(() => fetchNoteRSS(), []),
  safely(getAllWorks, { contents: [], totalCount: 0, offset: 0, limit: 0 }),
  safely(loadSongsData, []),
  safely(() => getLatestPhotos(5), []),
]);

// 焙煎中の豆: 焙煎できる豆を優先した並びの先頭
const roasting = sortBeansForDisplay(beans)[0];
const roastingNotes = roasting
  ? flavorColors(roasting.flavorNote, roasting.flavorColors)
  : [];
const roastingMeta = roasting
  ? [
      ...toArray(roasting.process).map(processLabel),
      ...toArray(roasting.roastLevel).map(roastLabel),
    ].join(" · ")
  : "";

const latestArticles = articles.slice(0, 3);

const works = worksResponse.contents
  .filter((work) => work.link)
  .slice(0, 3)
  .map((work) => ({
    title: work.title,
    outline: work.outline ?? "",
    href: work.link as string,
  }));

// 載せる量を絞る（2026-11-19）。曲は 3 曲、ジャケットは出さない
const tracks = songs.slice(0, 3);
const [leadPhoto, ...morePhotos] = photos;
// 2 枚目以降が無いときは、続きのマスを出さずに写真を下まで伸ばす
const hasMorePhotos = morePhotos.length > 0;
const photoSrc = (url: string, width: number) =>
  `${url}?w=${width}&fm=webp&q=75`;
---

<Layout title="takum1.me">
  <Container size="frame">
    <Grid>
      <!-- 名前 -->
      <Cell col="1 / 9" row="1 / 5" fit class="top-name">
        <h1 class="grid-giant top-name__word">takum1</h1>
      </Cell>

      <!-- 焙煎中の豆 -->
      {
        roasting && (
          <Cell col="9 / 13" row="1 / 4" spread href={beanPath(roasting)}>
            <div>
              <p class="grid-title-l">{roasting.name}</p>
              {roastingMeta && <p class="top-roast__meta">{roastingMeta}</p>}
            </div>
            <FlavorWords notes={roastingNotes} max={3} />
          </Cell>
        )
      }

      <Cell
        col="9 / 13"
        row={roasting ? "4 / 5" : "1 / 5"}
        href="/beans"
        class="top-cta"
      >
        <span class="grid-title-l">Beans</span>
      </Cell>

      <!-- プロフィール -->
      <Cell col="1 / 5" row="5 / 7" class="top-intro">
        <p class="grid-statement">
          Undergraduate / Brewer.<br />
          大学で情報科学を学びながら、<br />
          コーヒーを焙煎しています。
        </p>
      </Cell>

      <!-- 書いたもの -->
      <Cell col="5 / 11" row="5 / 8">
        <div class="grid-tag top-rule">
          <h2 class="grid-heading">Writing</h2>
          <a class="grid-label text-link" href="/blog">All</a>
        </div>
        <ul class="top-posts">
          {
            latestArticles.map((article) => (
              <li>
                <a
                  class="top-post link-row"
                  href={article.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="grid-number top-post__date">
                    {formatDotDate(article.pubDate)}
                  </span>
                  <span class="grid-entry">{article.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </Cell>

      <!-- 写真 -->
      <Cell
        col="11 / 13"
        row={hasMorePhotos ? "5 / 9" : "5 / 11"}
        sp="span 2"
        bleed
        as="figure"
        class="top-photo"
      >
        {
          leadPhoto && (
            <>
              <img
                src={photoSrc(leadPhoto.photo.url, 640)}
                alt={leadPhoto.place}
                width={leadPhoto.photo.width}
                height={leadPhoto.photo.height}
                loading="lazy"
              />
            </>
          )
        }
      </Cell>

      <!-- よく聴いているもの -->
      <Cell col="1 / 5" row="7 / 11" class="top-playlist">
        <h2 class="grid-heading">Playlist</h2>
        <ol class="top-tracks">
          {
            tracks.map((track, i) => (
              <li>
                <a
                  class="top-track link-row"
                  href={track.appleMusicUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="grid-number top-track__no">{i + 1}</span>
                  <span class="top-track__text">
                    <span class="top-track__title">{track.title}</span>
                    <span class="top-track__artist">{track.artist}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </Cell>

      <!-- つくったもの -->
      {
        works.map((work, i) => (
          <Cell
            col={["5 / 7", "7 / 9", "9 / 11"][i]}
            row="8 / 11"
            sp={i === 2 ? "span 2" : "span 1"}
            href={work.href}
            target="_blank"
            rel="noopener noreferrer"
            class="top-work"
          >
            <div>
              <p class="grid-title-m">{work.title}</p>
              {work.outline && <p class="top-work__outline">{work.outline}</p>}
            </div>
          </Cell>
        ))
      }

      <!-- 写真の続き -->
      {
        hasMorePhotos && (
          <Cell col="11 / 13" row="9 / 11" spread class="top-photos">
            <h2 class="grid-heading">Photos</h2>
            <div class="top-photos__thumbs">
              {morePhotos.slice(0, 4).map((photo) => (
                <img
                  src={photoSrc(photo.photo.url, 240)}
                  alt={photo.place}
                  width="120"
                  height="120"
                  loading="lazy"
                />
              ))}
            </div>
          </Cell>
        )
      }
    </Grid>
  </Container>
</Layout>

<style>
  /* --- 名前 ------------------------------------------------------------- */

  /* 字面の下端をマスの罫線に寄せる（中身が 1 つなので下に揃える） */
  .top-name {
    justify-content: flex-end;
    min-height: clamp(18rem, 34vw, 30rem);
    padding-bottom: 0;
  }

  .top-name__word {
    margin-left: -0.04em;
    margin-bottom: -0.02em;
  }

  /* --- 焙煎中の豆 ------------------------------------------------------- */

  /* 精製・焙煎度は豆の名前の 3 行目として、半分強の大きさ・薄い墨で続ける */
  .top-roast__meta {
    margin-top: var(--spacing-sm);
    color: var(--color-ink-faint);
    font-size: calc(var(--text-title-l) * 0.58);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .top-cta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  /* --- プロフィール ----------------------------------------------------- */

  /* --- 書いたもの・よく聴いているもの ----------------------------------- */

  .top-rule {
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-rule);
  }

  .top-posts,
  .top-tracks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .top-posts li + li {
    border-top: 1px solid var(--color-rule);
  }

  .top-post {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-lg);
    padding-block: var(--spacing-md);
    transition: color var(--transition);
  }

  .top-post:hover {
    color: var(--color-accent-strong);
  }

  .top-post__date {
    flex: none;
    width: 6.5rem;
  }

  /* 曲は見出しを上、一覧を下に寄せる。区切り線は引かない */
  .top-playlist {
    justify-content: space-between;
    gap: var(--spacing-lg);
  }

  .top-track {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  .top-track__no {
    flex: none;
    width: 1.5rem;
    color: var(--color-ink-faint);
  }

  .top-track__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .top-track__title {
    overflow: hidden;
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top-track__artist {
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .top-track:hover .top-track__title {
    color: var(--color-accent-strong);
  }

  /* --- 写真 ------------------------------------------------------------- */

  .top-photo {
    margin: 0;
  }

  .top-photo img {
    flex: 1;
    width: 100%;
    min-height: 14rem;
    object-fit: cover;
  }

  .top-photos__thumbs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
  }

  .top-photos__thumbs img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* --- つくったもの ----------------------------------------------------- */

  .top-work {
    justify-content: flex-end;
  }

  .top-work__outline {
    margin-top: var(--spacing-sm);
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  @media (width <= 48rem) {
    .top-name {
      min-height: 16rem;
    }

    .top-post {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .top-photos__thumbs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
