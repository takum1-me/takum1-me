---
/**
 * トップページ（A-1 グリッド）。
 * 段を積まず、12 カラムの罫線グリッドに大小のマスを詰めて 1 画面半に収める。
 */
import Layout from "../layouts/Layout.astro";
import { formatDotDate } from "../lib/utils/dot-date";
import Container from "../components/shared/layout/Container.astro";
import Grid from "../components/shared/grid/Grid.astro";
import Cell from "../components/shared/grid/Cell.astro";
import { getAllWorks, getLatestPhotos } from "../lib/microcms";
import {
  getAllBeans,
  sortBeansForDisplay,
  toArray,
  beanPath,
  type Bean,
} from "../lib/microcms/beans-list";
import { fetchNoteRSS, type NoteArticle } from "../lib/note-rss";
import { loadSongsData } from "../lib/songs-loader";
import { flavorColors } from "../lib/utils/flavor-color";
import { processLabel, roastLabel } from "../data/bean-meta";
import { SNS_LINKS } from "../data/site-links";

// --- データ ---------------------------------------------------------------
// どれか 1 つの取得に失敗しても、残りのマスは出せるようにしておく

async function safely<T>(load: () => Promise<T>, fallback: T): Promise<T> {
  try {
    return await load();
  } catch (error) {
    console.error("トップページのデータ取得に失敗しました:", error);
    return fallback;
  }
}

const [beans, articles, worksResponse, songs, photos] = await Promise.all([
  safely<Bean[]>(getAllBeans, []),
  safely<NoteArticle[]>(() => fetchNoteRSS(), []),
  safely(getAllWorks, { contents: [], totalCount: 0, offset: 0, limit: 0 }),
  safely(loadSongsData, []),
  safely(() => getLatestPhotos(5), []),
]);

// 焙煎中の豆: 焙煎できる豆を優先した並びの先頭
const roasting = sortBeansForDisplay(beans)[0];
const roastingNotes = roasting
  ? flavorColors(roasting.flavorNote, roasting.flavorColors).slice(0, 3)
  : [];
const roastingMeta = roasting
  ? [
      ...toArray(roasting.process).map(processLabel),
      ...toArray(roasting.roastLevel).map(roastLabel),
    ].join(" · ")
  : "";

const latestArticles = articles.slice(0, 3);

const works = worksResponse.contents
  .filter((work) => work.link)
  .slice(0, 3)
  .map((work) => ({
    title: work.title,
    outline: work.outline ?? "",
    href: work.link as string,
  }));

const tracks = songs.slice(0, 8);
const [leadPhoto, ...morePhotos] = photos;
// 2 枚目以降が無いときは、続きのマスを出さずに写真を下まで伸ばす
const hasMorePhotos = morePhotos.length > 0;
const photoSrc = (url: string, width: number) =>
  `${url}?w=${width}&fm=webp&q=75`;
---

<Layout title="takum1.me">
  <Container size="frame">
    <Grid>
      <!-- 名前 -->
      <Cell col="1 / 9" row="1 / 5" spread fit class="top-name">
        <div class="grid-tag">
          <span class="grid-label grid-label--accent">Coffee · Programming</span
          >
          <span class="grid-label grid-label--faint">Tsukuba, JP</span>
        </div>
        <h1 class="grid-giant top-name__word">takum1</h1>
      </Cell>

      <!-- 焙煎中の豆 -->
      {
        roasting && (
          <Cell
            col="9 / 13"
            row="1 / 4"
            tone="accent"
            spread
            href={beanPath(roasting)}
          >
            <div class="grid-tag">
              <span class="grid-label">Now Roasting</span>
              <span class="grid-label">
                {roasting.isAvailable ? "焙煎できます" : "生豆切れ"}
              </span>
            </div>
            <div>
              <p class="grid-serif-l">{roasting.name}</p>
              {roastingMeta && (
                <p class="grid-label top-roast__meta">{roastingMeta}</p>
              )}
            </div>
            {roastingNotes.length > 0 && (
              <div>
                <div class="top-roast__band">
                  {roastingNotes.map((note) => (
                    <span style={`background: ${note.color}`} />
                  ))}
                </div>
                <div class="grid-tag top-roast__notes">
                  {roastingNotes.map((note) => (
                    <span class="grid-label">{note.label}</span>
                  ))}
                </div>
              </div>
            )}
          </Cell>
        )
      }

      <Cell
        col="9 / 13"
        row={roasting ? "4 / 5" : "1 / 5"}
        tone="ink"
        href="/beans"
        class="top-cta"
      >
        <span class="grid-serif-l">Beans</span>
        <span class="grid-serif-l top-cta__arrow" aria-hidden="true">→</span>
      </Cell>

      <!-- プロフィール -->
      <Cell col="1 / 5" row="5 / 7" spread class="top-intro">
        <span class="grid-label grid-label--accent">Profile</span>
        <p class="grid-statement">
          大学でプログラミングをしています。<br />
          コーヒーが好きで、最近は焙煎も始めました。
        </p>
        <div class="top-intro__sns">
          {
            SNS_LINKS.map((sns) => (
              <a
                class="grid-label"
                href={sns.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {sns.short}
              </a>
            ))
          }
        </div>
      </Cell>

      <!-- 書いたもの -->
      <Cell col="5 / 11" row="5 / 8">
        <div class="grid-tag top-rule">
          <span class="grid-label grid-label--accent">Writing — 書いたもの</span
          >
          <a class="grid-label" href="/blog">All →</a>
        </div>
        <ul class="top-posts">
          {
            latestArticles.map((article) => (
              <li>
                <a
                  class="top-post"
                  href={article.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="grid-number top-post__date">
                    {formatDotDate(article.pubDate)}
                  </span>
                  <span class="grid-entry">{article.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </Cell>

      <!-- 写真 -->
      <Cell
        col="11 / 13"
        row={hasMorePhotos ? "5 / 9" : "5 / 11"}
        sp="span 2"
        bleed
        as="figure"
        class="top-photo"
      >
        {
          leadPhoto && (
            <>
              <img
                src={photoSrc(leadPhoto.photo.url, 640)}
                alt={leadPhoto.place}
                width={leadPhoto.photo.width}
                height={leadPhoto.photo.height}
                loading="lazy"
              />
              <figcaption class="top-photo__caption">
                {leadPhoto.place}
                <br />
                {formatDotDate(leadPhoto.date)}
              </figcaption>
            </>
          )
        }
      </Cell>

      <!-- よく聴いているもの -->
      <Cell col="1 / 5" row="7 / 11">
        <div class="grid-tag top-rule">
          <span class="grid-label grid-label--accent"
            >Playlist — よく聴いているもの</span
          >
        </div>
        <ol class="top-tracks">
          {
            tracks.map((track, i) => (
              <li>
                <a
                  class="top-track"
                  href={track.appleMusicUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="grid-number top-track__no">{i + 1}</span>
                  {track.artworkUrl ? (
                    <img
                      class="top-track__art"
                      src={track.artworkUrl}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                    />
                  ) : (
                    <span class="top-track__art" />
                  )}
                  <span class="top-track__text">
                    <span class="top-track__title">{track.title}</span>
                    <span class="top-track__artist">{track.artist}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </Cell>

      <!-- つくったもの -->
      {
        works.map((work, i) => (
          <Cell
            col={["5 / 7", "7 / 9", "9 / 11"][i]}
            row="8 / 11"
            sp={i === 2 ? "span 2" : "span 1"}
            tone={i === 1 ? "ink" : "base"}
            spread
            href={work.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="grid-tag">
              <span class="grid-label grid-label--accent">W—0{i + 1}</span>
              <span class="grid-label" aria-hidden="true">
                ↗
              </span>
            </div>
            <div>
              <p class="grid-serif-m">{work.title}</p>
              {work.outline && <p class="top-work__outline">{work.outline}</p>}
            </div>
          </Cell>
        ))
      }

      <!-- 写真の続き -->
      {
        hasMorePhotos && (
          <Cell col="11 / 13" row="9 / 11" spread class="top-photos">
            <span class="grid-label grid-label--accent">
              Photo — 日々の記録
            </span>
            <div class="top-photos__thumbs">
              {morePhotos.slice(0, 4).map((photo) => (
                <img
                  src={photoSrc(photo.photo.url, 240)}
                  alt={photo.place}
                  width="120"
                  height="120"
                  loading="lazy"
                />
              ))}
            </div>
          </Cell>
        )
      }
    </Grid>
  </Container>
</Layout>

<style>
  /* --- 名前 ------------------------------------------------------------- */

  .top-name {
    min-height: clamp(18rem, 34vw, 30rem);
    padding-bottom: 0;
  }

  /* 字面の下端をマスの罫線に寄せる */
  .top-name__word {
    margin-left: -0.04em;
    margin-bottom: -0.02em;
  }

  /* --- 焙煎中の豆 ------------------------------------------------------- */

  .top-roast__meta {
    margin-top: var(--spacing-md);
  }

  .top-roast__band {
    display: flex;
    height: 1.75rem;
    border: 1px solid var(--color-rule);
  }

  .top-roast__band span {
    flex: 1;
  }

  .top-roast__notes {
    margin-top: var(--spacing-sm);
  }

  .top-cta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .top-cta__arrow {
    color: var(--color-accent);
  }

  /* --- プロフィール ----------------------------------------------------- */

  .top-intro__sns {
    display: flex;
    margin: 0 calc(var(--spacing-cell) * -1) calc(var(--spacing-cell) * -1);
    border-top: 1px solid var(--color-rule);
  }

  .top-intro__sns a {
    flex: 1;
    padding-block: var(--spacing-md);
    border-right: 1px solid var(--color-rule);
    text-align: center;
    transition: background-color var(--transition);
  }

  .top-intro__sns a:last-child {
    border-right: 0;
  }

  .top-intro__sns a:hover {
    background: var(--color-bg-subtle);
  }

  /* --- 書いたもの・よく聴いているもの ----------------------------------- */

  .top-rule {
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-rule);
  }

  .top-posts,
  .top-tracks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .top-posts li + li {
    border-top: 1px solid var(--color-rule);
  }

  .top-post {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-lg);
    padding-block: var(--spacing-md);
    transition: color var(--transition);
  }

  .top-post:hover {
    color: var(--color-accent-strong);
  }

  .top-post__date {
    flex: none;
    width: 6.5rem;
  }

  .top-tracks li + li {
    border-top: 1px solid var(--color-line-strong);
  }

  .top-track {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding-block: var(--spacing-sm);
  }

  .top-track__no {
    flex: none;
    width: 1.5rem;
    color: var(--color-accent);
  }

  .top-track__art {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    object-fit: cover;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-rule);
  }

  .top-track__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .top-track__title {
    overflow: hidden;
    font-size: var(--text-small);
    font-weight: 700;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top-track__artist {
    color: var(--color-ink-faint);
    font-size: var(--text-label);
    line-height: 1.4;
  }

  .top-track:hover .top-track__title {
    color: var(--color-accent-strong);
  }

  /* --- 写真 ------------------------------------------------------------- */

  .top-photo {
    margin: 0;
  }

  .top-photo img {
    flex: 1;
    width: 100%;
    min-height: 14rem;
    object-fit: cover;
  }

  .top-photo__caption {
    padding: var(--spacing-sm) var(--spacing-md);
    border-top: 1px solid var(--color-rule);
    background: var(--color-bg);
    font-size: var(--text-label);
    line-height: 1.5;
  }

  .top-photos__thumbs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
  }

  .top-photos__thumbs img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* --- つくったもの ----------------------------------------------------- */

  .top-work__outline {
    margin-top: var(--spacing-sm);
    font-size: var(--text-label);
    line-height: 1.6;
    opacity: 80%;
  }

  @media (width <= 48rem) {
    .top-name {
      min-height: 16rem;
    }

    .top-post {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .top-photos__thumbs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
