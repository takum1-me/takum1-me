---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/layout/Container.astro";
import PageHeader from "../components/shared/page/PageHeader.astro";
import CuppingTimer from "../components/features/cupping/CuppingTimer";
---

<Layout
  title="カッピングタイマー - takum1.me"
  description="カッピング用のタイマー。注いでからの経過と、ブレイク・飲み始めまでの残りを 1 つのボタンで同時に走らせます。"
>
  <Container size="frame">
    <!-- 現場で開くページなので、3 つとボタンが 1 画面に収まるよう見出しは詰める -->
    <PageHeader
      title="カッピングタイマー"
      lead="注いでからの経過と、ブレイク・飲み始めまでの残りを同時に走らせます。"
      compact
    />

    <!-- タイマー自体が罫線グリッドなので、マスには包まずにそのまま続ける -->
    <CuppingTimer client:only="react" />
  </Container>
</Layout>
