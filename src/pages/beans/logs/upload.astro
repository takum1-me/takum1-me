---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/shared/layout/Container.astro";
import PageHeader from "../../../components/shared/page/PageHeader.astro";
import RoastLogUploader from "../../../components/features/beans/RoastLogUploader";
import { getAllBeans } from "../../../lib/microcms/beans-list";
import { getRoastLogs } from "../../../lib/roast-logs";
import manifest from "../../../data/roast-logs/index.json";

// ローカル専用ツール。本番ではデプロイ・公開しない（color-tool と同じ）。
if (!import.meta.env.DEV) {
  return Astro.redirect("/beans/logs");
}

const beans = await getAllBeans();

// すでに取り込んである分。生の系列は重いので落として渡す
const saved = getRoastLogs().map((log) => ({
  batchId: log.batchId,
  roastedAt: log.roastedAt,
  beanId: log.beanId,
  note: log.note,
}));
---

<Layout
  title="Roast Log Uploader"
  description="焙煎ログをリポジトリに取り込むローカル専用ツール"
>
  <Container size="page">
    <PageHeader
      eyebrow="Dev only"
      title="焙煎ログの取り込み"
      lead=".klog を読んでバッチ ID と指標を確認し、豆を紐付けて、リポジトリに取り込みます。"
    >
      <p slot="aside">
        開発サーバー経由で <code>src/data/roast-logs/</code> に直接書き込み、 そのまま
        commit と push まで走らせます。本番にはこの口はありません。
      </p>
    </PageHeader>

    <RoastLogUploader
      beans={beans}
      manifest={manifest}
      saved={saved}
      client:only="react"
    />
  </Container>
</Layout>
