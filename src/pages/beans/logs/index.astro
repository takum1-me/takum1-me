---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/shared/layout/Container.astro";
import PageHeader from "../../../components/shared/page/PageHeader.astro";
import Grid from "../../../components/shared/grid/Grid.astro";
import Cell from "../../../components/shared/grid/Cell.astro";
import { getRoastLogs } from "../../../lib/roast-logs";
import { mmss, percent, celsius } from "../../../lib/utils/klog";
import { getAllBeans } from "../../../lib/microcms/beans-list";

/**
 * 焙煎ログの一覧。バッチ ID・豆名・プロファイル・日付で絞り込める。
 * 検索は静的 HTML に対する行フィルタなので、JS が無くても全件は読める。
 */
const logs = getRoastLogs();
const beans = await getAllBeans();
const beanName = new Map(beans.map((b) => [b.id, b.name]));

const rows = logs.map((log) => {
  const bean = log.beanId ? beanName.get(log.beanId) : undefined;
  const date = log.roastedAt
    ? new Date(log.roastedAt).toLocaleString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "Asia/Tokyo",
      })
    : "—";
  return {
    ...log,
    bean,
    date,
    /** 豆フィルタの照合キー。紐付けの無いログは "none" にまとめる */
    beanKey: log.beanId ?? "none",
    // 検索対象をまとめた 1 本の文字列（小文字化して data 属性に載せる）
    haystack: [log.batchId, bean, log.profileName, date, log.note]
      .filter(Boolean)
      .join(" ")
      .toLowerCase(),
  };
});

/**
 * 豆の絞り込みボタン。実際にログがある豆だけを、件数の多い順に出す
 * （押しても 0 件になるボタンを並べない）。
 */
const beanCounts = new Map<string, number>();
for (const row of rows)
  beanCounts.set(row.beanKey, (beanCounts.get(row.beanKey) ?? 0) + 1);

const beanFilters = [...beanCounts.entries()]
  .map(([key, count]) => ({
    key,
    label: key === "none" ? "紐付けなし" : (beanName.get(key) ?? key),
    count,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, "ja"));
---

<Layout
  title="焙煎ログ - Beans - takum1.me"
  description="Kaffelogic nano 7 で焙煎したバッチのログ一覧。"
>
  <Container size="frame">
    <PageHeader
      word="Logs"
      title="焙煎ログ"
      lead="Kaffelogic nano 7 の焙煎ログです。バッチを開くと温度と RoR の記録が見られます。"
    >
      <p slot="aside">
        ID は「焙煎機のログ番号 - 焙煎日」です。<br />
        <a href="/beans">← 焙煎豆リスト</a>
      </p>
    </PageHeader>

    <Grid class="logs-grid">
      {
        beanFilters.length > 1 && (
          <Cell col="1 / 9" class="beans" id="bean-filters">
            <span class="grid-label grid-label--accent">Bean — 豆で絞る</span>
            <div class="chips">
              <button
                type="button"
                class="chip"
                data-bean="all"
                aria-pressed="true"
              >
                すべて
                <span class="chip__count">{rows.length}</span>
              </button>
              {beanFilters.map((filter) => (
                <button
                  type="button"
                  class="chip"
                  data-bean={filter.key}
                  aria-pressed="false"
                >
                  {filter.label}
                  <span class="chip__count">{filter.count}</span>
                </button>
              ))}
            </div>
          </Cell>
        )
      }

      <Cell
        col={beanFilters.length > 1 ? "9 / 13" : "1 / 13"}
        tone="ink"
        spread
        class="tools"
      >
        <label class="search">
          <span class="grid-label">Search — 検索</span>
          <input
            type="search"
            id="log-search"
            placeholder="バッチ ID / 豆 / プロファイル / 日付"
            autocomplete="off"
          />
        </label>
        <p class="grid-label count" id="log-count">{rows.length} 件</p>
      </Cell>

      <Cell col="1 / 13" class="logs-cell">
        <div class="logs-head" aria-hidden="true">
          <span class="grid-label grid-label--accent">ID</span>
          <span class="grid-label grid-label--accent">豆 / 日時</span>
          <span class="grid-label grid-label--accent logs-head__stats">
            1ハゼ · 合計 · DTR · 煎り上げ
          </span>
        </div>
        {
          rows.length === 0 ? (
            <p class="empty">まだ焙煎ログがありません。</p>
          ) : (
            <ul class="logs" id="log-list">
              {rows.map((row) => (
                <li
                  class="logs__item"
                  data-haystack={row.haystack}
                  data-bean={row.beanKey}
                >
                  <a
                    class="logs__link link-row"
                    href={`/beans/logs/${row.batchId}`}
                  >
                    <span class="logs__id">{row.batchId}</span>
                    <span class="logs__main">
                      <span class="logs__bean">
                        {row.bean ?? "豆の紐付けなし"}
                      </span>
                      <span class="logs__meta">
                        {row.date}
                        {row.profileName && ` · ${row.profileName}`}
                      </span>
                    </span>
                    <span class="logs__stats">
                      <span class="stat">
                        <span class="stat__label">1ハゼ</span>
                        <span class="stat__value">
                          {mmss(row.metrics.firstCrackSec)}
                        </span>
                      </span>
                      <span class="stat">
                        <span class="stat__label">合計</span>
                        <span class="stat__value">
                          {mmss(row.metrics.totalSec)}
                        </span>
                      </span>
                      <span class="stat">
                        <span class="stat__label">DTR</span>
                        <span class="stat__value">
                          {percent(row.metrics.developmentPercent)}
                        </span>
                      </span>
                      <span class="stat">
                        <span class="stat__label">煎り上げ</span>
                        <span class="stat__value">
                          {celsius(row.metrics.endTemp)}
                        </span>
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <p class="none" id="log-none" hidden>該当する焙煎ログがありません。</p>
      </Cell>
    </Grid>
  </Container>
</Layout>

<script>
  // 静的に並べた行を絞り込むだけ。件数表示も合わせて更新する。
  const input = document.querySelector<HTMLInputElement>("#log-search");
  const list = document.querySelector<HTMLUListElement>("#log-list");
  const count = document.querySelector<HTMLElement>("#log-count");
  const none = document.querySelector<HTMLElement>("#log-none");

  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#bean-filters .chip"),
  );

  if (list) {
    const items = Array.from(
      list.querySelectorAll<HTMLLIElement>(".logs__item"),
    );
    // 豆ボタンとテキスト検索は AND で効かせる
    let bean = "all";

    const apply = () => {
      const query = input?.value.trim().toLowerCase() ?? "";
      let shown = 0;
      for (const item of items) {
        const hit =
          (bean === "all" || item.dataset.bean === bean) &&
          (query === "" || (item.dataset.haystack ?? "").includes(query));
        item.hidden = !hit;
        if (hit) shown += 1;
      }
      if (count) count.textContent = `${shown} 件`;
      if (none) none.hidden = shown > 0;
    };

    input?.addEventListener("input", apply);

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        // 押されているものをもう一度押したら解除して全件に戻す
        bean =
          bean === chip.dataset.bean ? "all" : (chip.dataset.bean ?? "all");
        for (const other of chips) {
          other.setAttribute(
            "aria-pressed",
            String(other.dataset.bean === bean),
          );
        }
        apply();
      });
    }
  }
</script>

<style>
  .logs-grid {
    grid-auto-rows: auto;
  }

  /* --- 絞り込み ---------------------------------------------------------- */

  .chips {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--spacing-md);
    border-top: 1px solid var(--color-rule);
    border-left: 1px solid var(--color-rule);
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-bg);
    border: 0;
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
    font-family: inherit;
    font-size: var(--text-small);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  .chip:hover {
    background: var(--color-bg-subtle);
  }

  .chip[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .chip__count {
    font-family: var(--font-serif);
    font-weight: 400;
    opacity: 70%;
  }

  /* --- 検索（墨のマス）--------------------------------------------------- */

  .search {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .search input {
    width: 100%;
    padding: var(--spacing-sm) var(--spacing-md);
    background: transparent;
    border: 1px solid var(--color-ink-muted);
    color: var(--color-on-ink);
    font: inherit;
    font-size: var(--text-small);
  }

  .search input::placeholder {
    color: var(--color-line-strong);
  }

  .search input:focus-visible {
    border-color: var(--color-accent);
    outline: none;
  }

  /* --- 一覧 -------------------------------------------------------------- */

  .logs-head,
  .logs__link {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    gap: var(--spacing-lg);
    align-items: baseline;
  }

  .logs-head {
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-rule);
  }

  .logs-head__stats {
    text-align: right;
  }

  .logs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logs__item + .logs__item {
    border-top: 1px solid var(--color-line-strong);
  }

  .logs__link {
    padding-block: var(--spacing-md);
    transition: background-color var(--transition);
  }

  .logs__link:hover {
    background: var(--color-bg-subtle);
  }

  .logs__id {
    font-family: var(--font-serif);
    font-size: var(--text-lead);
  }

  .logs__main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .logs__bean {
    font-weight: 700;
  }

  .logs__meta {
    color: var(--color-ink-faint);
    font-size: var(--text-small);
  }

  .logs__stats {
    display: flex;
    gap: var(--spacing-lg);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .stat__label {
    color: var(--color-ink-faint);
    font-size: var(--text-label);
    font-weight: 700;
  }

  .stat__value {
    font-family: var(--font-serif);
    font-size: var(--text-lead);
  }

  .empty,
  .none {
    padding-block: var(--spacing-md);
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  @media (width <= 48rem) {
    .logs-head {
      display: none;
    }

    .logs__link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-sm);
    }

    .stat {
      align-items: flex-start;
    }
  }
</style>
