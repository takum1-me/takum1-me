---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/shared/layout/Container.astro";
import PageHeader from "../../../components/shared/page/PageHeader.astro";
import Grid from "../../../components/shared/grid/Grid.astro";
import Cell from "../../../components/shared/grid/Cell.astro";
import { getRoastLogs } from "../../../lib/roast-logs";
import { buildRoastChartSvg } from "../../../lib/utils/roast-chart";
import { mmss, percent, celsius, type KlogLog } from "../../../lib/utils/klog";
import { getAllBeans, type Bean } from "../../../lib/microcms/beans-list";
import type { RoastLogRecord } from "../../../lib/roast-logs";

/** バッチ 1 件の詳細。グラフと指標、焙煎機の記録を出す。 */
export async function getStaticPaths() {
  const beans = await getAllBeans();
  const byId = new Map(beans.map((b) => [b.id, b]));
  return getRoastLogs().map((record) => ({
    params: { batch: record.batchId },
    props: {
      record,
      bean: record.beanId ? byId.get(record.beanId) : undefined,
    },
  }));
}

// props の型は getStaticPaths から流れてくる
const { record, bean } = Astro.props as { record: RoastLogRecord; bean?: Bean };
const { log, metrics } = record;

const chart = buildRoastChartSvg(log, {
  label: `${record.batchId} の焙煎グラフ`,
});

const roastedAt = record.roastedAt
  ? new Date(record.roastedAt).toLocaleString("ja-JP", {
      year: "numeric",
      month: "long",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Asia/Tokyo",
    })
  : undefined;

const metricRows: [string, string][] = [
  ["カラーチェンジ", mmss(metrics.colourChangeSec)],
  ["1 ハゼ", mmss(metrics.firstCrackSec)],
  ["DTR", percent(metrics.developmentPercent)],
  // 焙煎終了の時刻と同じ値なので、行はこちらに寄せる
  ["焙煎時間", mmss(metrics.totalSec)],
  // 最大値ではなく終了時点の温度
  ["煎り上げ温度", celsius(metrics.endTemp)],
];

const phaseRows: [string, string][] = [
  ["ドライ", mmss(metrics.dryingSec)],
  ["メイラード", mmss(metrics.maillardSec)],
  ["デベロップメント", mmss(metrics.developmentSec)],
];

/** 焙煎機側の記録。ヘッダに無い項目は落とす */
const recordRows = (
  [
    ["焙煎レベル", numeric(log, "roasting_level", 2)],
    ["室温", numeric(log, "ambient_temperature", 1, "°C")],
    // model ヘッダは <機種>/<地域>/<製造番号> の形で機体のシリアルを含むので、
    // メーカー名だけに丸めて出す
    ["機種", log.header.model ? "Kaffelogic" : undefined],
  ] as [string, string | undefined][]
).filter((row): row is [string, string] => Boolean(row[1]));

function numeric(
  source: KlogLog,
  key: string,
  digits: number,
  unit = "",
): string | undefined {
  const raw = source.header[key];
  if (raw === undefined) return undefined;
  const n = Number.parseFloat(raw);
  return Number.isNaN(n) ? undefined : `${n.toFixed(digits)}${unit}`;
}

const description = [
  bean?.name,
  roastedAt,
  `1ハゼ ${mmss(metrics.firstCrackSec)}`,
  `Dev ${percent(metrics.developmentPercent)}`,
]
  .filter(Boolean)
  .join(" / ");
---

<Layout
  title={`${record.batchId} - 焙煎ログ - takum1.me`}
  description={description}
  og={{ type: "article", title: `${record.batchId} - 焙煎ログ - takum1.me` }}
>
  <Container size="frame">
    <PageHeader title={record.batchId} lead={description}>
      <p slot="aside">
        <a href="/beans/logs">← 焙煎ログ一覧</a>
        {
          bean && (
            <>
              <br />
              <a href={`/beans/${bean.id}`}>{bean.name} の豆ページ</a>
            </>
          )
        }
      </p>
    </PageHeader>

    <Grid class="batch-grid">
      {
        record.note && (
          <Cell col="1 / 13" tone="subtle">
            <p class="grid-label grid-label--accent">Note — メモ</p>
            <p class="note">{record.note}</p>
          </Cell>
        )
      }

      <Cell col="1 / 13" as="figure" class="chart">
        <div class="grid-tag">
          <span class="grid-label grid-label--accent">Curve — 温度と RoR</span>
          <span class="grid-label">{record.batchId}</span>
        </div>
        <Fragment set:html={chart} />
        <figcaption>
          左軸が温度、右軸が RoR（℃/min）。投入直後の RoR
          は枠外まで跳ねるので、焙煎中が読める範囲に軸を合わせています。
        </figcaption>
      </Cell>

      {
        [
          ["Log — 焙煎ログ", metricRows],
          ["Phase — フェーズ", phaseRows],
          ["Record — 焙煎の記録", recordRows],
        ].map(([title, rows], i) => (
          <Cell col={`${1 + i * 4} / ${5 + i * 4}`} as="section">
            <h2 class="grid-label grid-label--accent">{title as string}</h2>
            <dl class="rows">
              {(rows as [string, string][]).map(([label, value]) => (
                <div class="row">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </Cell>
        ))
      }
    </Grid>
  </Container>
</Layout>

<style>
  .batch-grid {
    grid-auto-rows: auto;
  }

  .note {
    margin-top: var(--spacing-sm);
    color: var(--color-ink-muted);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  .chart {
    gap: var(--spacing-md);
    margin: 0;
  }

  .chart figcaption {
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .rows {
    display: flex;
    flex-direction: column;
    margin-top: var(--spacing-md);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding-block: var(--spacing-sm);
    border-top: 1px solid var(--color-rule);
  }

  .row dt {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  .row dd {
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
</style>
