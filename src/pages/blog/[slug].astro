---
import { getAllBlog, getBlogById } from "../../lib/microcms";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/layout/Container.astro";
import BlogToc from "../../components/features/blog/BlogToc.tsx";
import "../../styles/prose.css";

export async function getStaticPaths() {
  try {
    const blogs = await getAllBlog();
    return blogs.contents.map((blog: { slug: string }) => ({
      params: { slug: blog.slug },
    }));
  } catch (error) {
    // 環境変数が設定されていない場合は空の配列を返す
    return [];
  }
}

const { slug } = Astro.params;
const blog = await getBlogById(slug);

// ブログが見つからない場合は404を返す
if (!blog) {
  return Astro.redirect("/404");
}

const { publishedAt, title, content, thumbnail } = blog;
const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Tokyo",
  });
};
---

<Layout title={title}>
  <Container size="wide" class="blog-layout">
    <article class="article">
      <a class="article__back" href="/blog">
        <span aria-hidden="true">←</span> ブログ一覧に戻る
      </a>

      <header class="article__header">
        <p class="article__meta">
          <time datetime={publishedAt}>{formatDate(publishedAt)}</time>
        </p>
        <h1 class="article__title">{title}</h1>
      </header>

      {
        thumbnail && (
          <img
            class="article__eyecatch"
            src={thumbnail.url}
            alt=""
            loading="lazy"
          />
        )
      }

      <div class="prose" set:html={content} />
    </article>

    <div class="blog-layout__toc">
      <BlogToc client:only="react" />
    </div>
  </Container>
</Layout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--container-prose)) minmax(0, 15rem);
    justify-content: center;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
    padding-block: var(--spacing-xl) var(--spacing-3xl);
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    font-weight: 600;
    transition: color var(--transition);
  }

  .article__back:hover {
    color: var(--color-accent-strong);
  }

  .article__header {
    margin-block: var(--spacing-xl) var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .article__meta {
    margin-bottom: 0.85rem;
    color: var(--color-ink-faint);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    font-variant-numeric: tabular-nums;
  }

  .article__title {
    font-size: var(--text-h1);
    font-weight: 700;
    line-height: var(--text-h1--line-height);
    letter-spacing: var(--text-h1--letter-spacing);
  }

  .article__eyecatch {
    width: 100%;
    height: auto;
    margin-bottom: var(--spacing-xl);
    border-radius: var(--radius-md);
  }

  @media (width <= 64rem) {
    .blog-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .blog-layout__toc {
      display: none;
    }
  }
</style>
