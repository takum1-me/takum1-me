---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/layout/Container.astro";
import PageHeader from "../../components/shared/page/PageHeader.astro";
import {
  fetchNoteRSS,
  fetchThumbnailsForArticles,
  type NoteArticle,
} from "../../lib/note-rss";
import ArticleCard from "../../components/shared/card/ArticleCard";
import "../../components/shared/card/overlay-card.css";

// note.comのRSSから記事を取得
let noteArticles: NoteArticle[];
try {
  // RSSフィードから直接サムネイル画像も取得する
  noteArticles = await fetchNoteRSS();

  // RSSにサムネイルが含まれていない場合は、OGP画像を取得（フォールバック）
  const articlesWithoutThumbnail = noteArticles.filter(
    (article) => !article.thumbnail,
  );

  if (articlesWithoutThumbnail.length > 0) {
    const articlesWithOGPThumbnails = await fetchThumbnailsForArticles(
      articlesWithoutThumbnail.slice(0, 5),
    );
    // OGPから取得したサムネイルをマージ
    articlesWithOGPThumbnails.forEach((articleWithThumb) => {
      const index = noteArticles.findIndex(
        (a) => a.link === articleWithThumb.link,
      );
      if (index !== -1 && articleWithThumb.thumbnail) {
        noteArticles[index].thumbnail = articleWithThumb.thumbnail;
      }
    });
  }
} catch (error) {
  console.error("Error fetching Note articles:", error);
  noteArticles = [];
}
---

<Layout title="Blog">
  <Container size="page">
    <PageHeader
      eyebrow="Blog"
      title="書いたもの"
      lead="note に書いた記事です。コーヒーのこと、つくったもののこと、日々考えていること。"
    />

    {
      noteArticles.length === 0 ? (
        <p class="blog-empty">
          記事の取得に失敗しました。ネットワークを確認してください。
        </p>
      ) : (
        <>
          <div class="blog-grid">
            {noteArticles.map((article) => (
              <div class="blog-card-cell">
                <ArticleCard
                  title={article.title}
                  summary={article.description}
                  publishedAt={article.pubDate}
                  thumbnail={
                    article.thumbnail ? { url: article.thumbnail } : undefined
                  }
                  link={article.link}
                  category="note"
                />
              </div>
            ))}
          </div>

          <nav class="pagination" aria-label="ページ送り">
            <button id="prev-page" class="pagination__btn" disabled>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M10 12L6 8L10 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              back
            </button>

            <p class="pagination__count">
              <span id="current-page">1</span>
              <span class="pagination__sep" aria-hidden="true">
                /
              </span>
              <span id="total-pages">1</span>
            </p>

            <button id="next-page" class="pagination__btn">
              next
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M6 4L10 8L6 12"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </nav>
        </>
      )
    }
  </Container>
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  .blog-empty {
    color: var(--color-ink-muted);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block: var(--spacing-2xl) var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-line);
  }

  .pagination__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0;
    background: none;
    border: 0;
    color: var(--color-ink-muted);
    font-family: inherit;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      color var(--transition),
      opacity var(--transition);
  }

  .pagination__btn:disabled {
    opacity: 25%;
    cursor: default;
  }

  .pagination__btn:hover:not(:disabled) {
    color: var(--color-accent-strong);
  }

  .pagination__count {
    display: flex;
    gap: 0.4rem;
    color: var(--color-ink-faint);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  @media (width <= 47.9375rem) {
    .pagination {
      display: none;
    }
  }
</style>

<script>
  import { initializeBlogPagination } from "../../lib/utils/blog-pagination";
  initializeBlogPagination();
</script>
