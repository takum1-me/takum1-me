---
import Layout from "../../layouts/Layout.astro";
import { formatDotDate } from "../../lib/utils/dot-date";
import Container from "../../components/shared/layout/Container.astro";
import PageHeader from "../../components/shared/page/PageHeader.astro";
import {
  fetchNoteRSS,
  fetchThumbnailsForArticles,
  type NoteArticle,
} from "../../lib/note-rss";
import Grid from "../../components/shared/grid/Grid.astro";
import Cell from "../../components/shared/grid/Cell.astro";

// note.comのRSSから記事を取得
let noteArticles: NoteArticle[];
try {
  // RSSフィードから直接サムネイル画像も取得する
  noteArticles = await fetchNoteRSS();

  // RSSにサムネイルが含まれていない場合は、OGP画像を取得（フォールバック）
  const articlesWithoutThumbnail = noteArticles.filter(
    (article) => !article.thumbnail,
  );

  if (articlesWithoutThumbnail.length > 0) {
    const articlesWithOGPThumbnails = await fetchThumbnailsForArticles(
      articlesWithoutThumbnail.slice(0, 5),
    );
    // OGPから取得したサムネイルをマージ
    articlesWithOGPThumbnails.forEach((articleWithThumb) => {
      const index = noteArticles.findIndex(
        (a) => a.link === articleWithThumb.link,
      );
      if (index !== -1 && articleWithThumb.thumbnail) {
        noteArticles[index].thumbnail = articleWithThumb.thumbnail;
      }
    });
  }
} catch (error) {
  console.error("Error fetching Note articles:", error);
  noteArticles = [];
}

// 最新の 1 本だけ大きく出し、残りをページ送りの対象にする
const [latest, ...rest] = noteArticles;
---

<Layout title="Blog">
  <Container size="frame">
    <PageHeader word="Blog" title="書いたもの" lead="note に書いた記事です。" />

    {
      noteArticles.length === 0 ? (
        <Grid>
          <Cell>
            <p class="blog-empty">記事を読み込めませんでした。</p>
          </Cell>
        </Grid>
      ) : (
        <Grid>
          {latest && (
            <>
              <Cell
                col={latest.thumbnail ? "1 / 9" : "1 / 13"}
                row="span 2"
                tone="ink"
                spread
                href={latest.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="grid-tag">
                  <span class="grid-label">Latest — note ↗</span>
                  <span class="grid-number">
                    {formatDotDate(latest.pubDate)}
                  </span>
                </div>
                <div>
                  <p class="blog-latest__title">{latest.title}</p>
                  <p class="blog-latest__summary">{latest.description}</p>
                </div>
              </Cell>
              {latest.thumbnail && (
                <Cell
                  col="9 / 13"
                  row="span 2"
                  bleed
                  class="blog-latest__photo"
                >
                  <img src={latest.thumbnail} alt="" loading="lazy" />
                </Cell>
              )}
            </>
          )}

          {rest.map((article) => (
            <Cell
              col="span 4"
              spread
              href={article.link}
              target="_blank"
              rel="noopener noreferrer"
              class="blog-card-cell"
            >
              <div class="grid-tag">
                <span class="grid-number blog-card__date">
                  {formatDotDate(article.pubDate)}
                </span>
                <span class="grid-label" aria-hidden="true">
                  ↗
                </span>
              </div>
              <div>
                {article.thumbnail && (
                  <div class="blog-card__thumb">
                    <img src={article.thumbnail} alt="" loading="lazy" />
                  </div>
                )}
                <p class="grid-entry">{article.title}</p>
                <p class="blog-card__summary">{article.description}</p>
              </div>
            </Cell>
          ))}

          <Cell col="1 / 13" class="pagination">
            <nav class="grid-tag pagination__inner" aria-label="ページ送り">
              <button
                id="prev-page"
                class="grid-label pagination__btn"
                disabled
              >
                ← Back
              </button>
              <p class="grid-number pagination__count">
                <span id="current-page">1</span>
                <span aria-hidden="true"> / </span>
                <span id="total-pages">1</span>
              </p>
              <button id="next-page" class="grid-label pagination__btn">
                Next →
              </button>
            </nav>
          </Cell>
        </Grid>
      )
    }
  </Container>
</Layout>

<style>
  .blog-empty {
    color: var(--color-ink-muted);
  }

  .blog-latest__title {
    font-family: var(--font-serif);
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.4;
  }

  .blog-latest__summary {
    display: -webkit-box;
    margin-top: var(--spacing-md);
    overflow: hidden;
    color: var(--color-line-strong);
    font-size: var(--text-small);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .blog-latest__photo img {
    flex: 1;
    width: 100%;
    min-height: 14rem;
    object-fit: cover;
  }

  .blog-card__date {
    color: var(--color-accent);
  }

  .blog-card__thumb {
    aspect-ratio: 16 / 9;
    margin-bottom: var(--spacing-md);
    overflow: hidden;
    border: 1px solid var(--color-rule);
  }

  .blog-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card__summary {
    display: -webkit-box;
    margin-top: var(--spacing-sm);
    overflow: hidden;
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .pagination__btn {
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
    transition:
      color var(--transition),
      opacity var(--transition);
  }

  .pagination__btn:disabled {
    opacity: 25%;
    cursor: default;
  }

  .pagination__btn:hover:not(:disabled) {
    color: var(--color-accent-strong);
  }

  .pagination__inner {
    align-items: center;
  }

  @media (width <= 47.9375rem) {
    .pagination {
      display: none;
    }
  }
</style>

<script>
  import { initializeBlogPagination } from "../../lib/utils/blog-pagination";
  initializeBlogPagination();
</script>
