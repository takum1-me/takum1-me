---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/layout/Container.astro";
import PageHeader from "../components/shared/page/PageHeader.astro";
import { BeansShowcase } from "../components/features/beans";
import { getAllBeans, sortBeansForDisplay } from "../lib/microcms/beans-list";
import { getRoastLogLinksByBean } from "../lib/roast-logs";

const sorted = sortBeansForDisplay(await getAllBeans());
const roastLogs = getRoastLogLinksByBean();
---

<Layout title="Beans" description="takum1が焙煎している豆のリストです。">
  <Container size="page">
    <PageHeader
      title="焙煎豆リスト"
      lead="Kaffelogic nano 7 で焙煎しています。飲みたい豆があったらいつでも言ってね。"
    >
      <p slot="aside">
        カードの下の色は、飲んで感じたフレーバーの色です。<br />
        <a href="/beans/logs">焙煎ログ</a><br />
        <a href="/cupping">カッピングタイマー</a>
      </p>
    </PageHeader>

    <BeansShowcase beans={sorted} roastLogs={roastLogs} client:only="react" />
  </Container>
</Layout>
