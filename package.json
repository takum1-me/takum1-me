{
  "name": "permanent-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev",
    "astro": "astro",
    "typecheck": "astro check",
    "cf-typegen": "wrangler types",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:css:astro": "node check-astro-styles.js",
    "character-wheel:data": "node scripts/extract-character-wheel.mjs",
    "character-wheel:debug": "node scripts/debug-character-wheel.mjs",
    "c-all": "npm run format:check && npm run lint && npm run lint:css && npm run lint:css:astro && npm run typecheck",
    "fix": "npm run format && npm run lint -- --fix && npm run lint:css:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "astro": "^5.18.2",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.3.1",
    "@astrojs/ts-plugin": "^1.10.4",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.32.0"
  }
}
